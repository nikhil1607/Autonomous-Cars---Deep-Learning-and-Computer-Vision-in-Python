# CODE TO CONVERT COLOR IMAGES TO GRAYSCALE
# Import all the necessary libraries
import matplotlib.image as mpimg
import matplotlib.pyplot as plt
import numpy as np
import cv2
# Read/Display an image
image_color = mpimg.imread('image_lane_c.jpg')

plt.imshow(image_color)
image_color.shape
# Convert an image into Grayscale
image_gray = cv2.cvtColor(image_color, cv2.COLOR_RGB2GRAY) #Corrected... image is RGB, not BGR.
plt.imshow(image_gray, cmap = 'gray')

image_gray.shape
image_gray
import sys
np.set_printoptions(threshold=sys.maxsize)
image_gray
# Save the Grayscale image
# Save the image in greyscale
cv2.imwrite("image_lane_g.jpg", image_gray)

# Well done!
